@modules
[
    (
        id: "usart_3",
        kind: GenericInterfaceUsart,
        name: "USART1",
        pos: (-248.47406, 270.4309),
        config: Usart((
            instance: 1,
            baud_rate: 115200,
            data_bits: 8,
            parity: None,
            stop_bits: One,
            rx_model: "",
            tx_model: "",
            custom_label: "mw radar",
            api_style: Portable,
            direction: TxRx,
            flow: None,
            swap_rx_tx: false,
            invert_tx: false,
            invert_rx: false,
            half_duplex_readback: false,
            mode: Buffered,
            buf_len: 256,
        )),
        connections: [
            (
                signal: Tx,
                mcu_pin: 9,
            ),
            (
                signal: Rx,
                mcu_pin: 10,
            ),
        ],
    ),
    (
        id: "i2c_2",
        kind: GenericInterfaceI2c,
        name: "I2C0",
        pos: (-69.79297, -377.43564),
        config: I2c((
            instance: 0,
            clock_hz: 400000,
            address: 60,
            devices: [
                (
                    name: "128x32 diplay ",
                    address: 60,
                    uid: 1,
                ),
            ],
            rx_model: "",
            tx_model: "",
            custom_label: "128x32 diplay",
            api_style: Portable,
            async_mode: Blocking,
            timeout_ms: 0,
        )),
        connections: [
            (
                signal: Scl,
                mcu_pin: 28,
            ),
            (
                signal: Sda,
                mcu_pin: 27,
            ),
        ],
    ),
    (
        id: "pwm_4",
        kind: GenericInterfaceTimer,
        name: "PWM0",
        pos: (184.91473, 206.94006),
        config: Timer((
            instance: 0,
            freq_hz: 5000,
            duty_x100: {
                1: 2000,
            },
            counting: EdgeUp,
            dead_time: 0,
            channels: {},
            breaks: {},
            auto_output_enable: false,
            rx_model: "",
            tx_model: "",
            custom_label: "power led",
        )),
        connections: [
            (
                signal: PwmCh1,
                mcu_pin: 16,
            ),
        ],
    ),
    (
        id: "custom_4",
        kind: Custom,
        name: "Custom1",
        pos: (-513.02527, -33.704163),
        config: Custom((
            instance: 1,
            pins: [
                5,
                6,
                8,
            ],
            applied_pins: [
                5,
                6,
                8,
            ],
            struct_name: "Encoder",
            applied_sig: "5:GpioInput|clk;6:GpioInput|dt;8:GpioInput|sw",
            revision: 0,
            rx_model: "",
            tx_model: "",
            custom_label: "menu nav",
        )),
        connections: [
            (
                signal: CustomPin,
                mcu_pin: 5,
            ),
            (
                signal: CustomPin,
                mcu_pin: 6,
            ),
            (
                signal: CustomPin,
                mcu_pin: 8,
            ),
        ],
    ),
]

@runtime
Async

@groups
9,10,12=Microwave Radar
5,6,8=Control Pannel
@groupi2c
i2c0/1=Control Pannel

@iopins
12=-19.299316,288.75732
14=49.467102,226.875
16=-227.12056,312.83276

@i2cpos
i2c0/1=-510.13788,-102.05151

@iomode
8=PullUp
12=PullDown
16=PullDown

@labels
5=clk
6=dt
8=sw
12=mw_ot2
14=board_led

@modulenotes
(kind:GenericInterfaceUsart,instance:1,text:"Microwave radar sensor that  detects movement and prezence",link:"https://www.waveshare.com/wiki/HMMD_mmWave_Sensor",image:"docs/modules/hmmd-mmwave-sensor-3_2.jpg")
